# Copy to .env.local for local development.
# In Hostinger hPanel → Node.js App → Environment variables, set production values.

# Production site URL (used by next-sitemap for sitemap.xml and canonical URLs)
SITE_URL=https://www.profixandshine.co.uk

# Google Analytics measurement ID (optional)
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Hostinger sets PORT automatically when using Node.js mode (optional).
# Static export (`out/`) does not need a start server.
